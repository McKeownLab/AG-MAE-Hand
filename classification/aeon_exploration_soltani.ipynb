    "def smooth_timeseries(X, window_length=7, polyorder=2):\n",
    "    \"\"\"\n",
    "    Apply Savitzky-Golay smoothing to time series signals.\n",
    "    \n",
    "    Parameters:\n",
    "    - X: np.ndarray of shape (n_samples, n_channels, n_timestamps)\n",
    "    - window_length: int, size of the smoothing window (must be odd)\n",
    "    - polyorder: int, polynomial order for the filter\n",
    "\n",
    "    Returns:\n",
    "    - Smoothed version of X\n",
    "    \"\"\"\n",
    "    X_smooth = np.copy(X)\n",
    "    n_samples, n_timestamps = X.shape\n",
    "\n",
    "    # Safety adjustments\n",
    "    if window_length >= n_timestamps:\n",
    "        window_length = n_timestamps - 1\n",
    "    if window_length % 2 == 0:\n",
    "        window_length -= 1\n",
    "    if polyorder >= window_length:\n",
    "        polyorder = window_length - 1\n",
    "    \n",
    "    for i in range(n_samples):\n",
    "        try:\n",
    "            X_smooth[i, :] = savgol_filter(X[i, :], window_length, polyorder)\n",
    "        except Exception as e:\n",
    "            print(f\"Warning at sample {i}: {e}\")\n",
    "            X_smooth[i, :] = X[i, :]  # fallback to original\n",
    "    return X_smooth"
   ]
  },
