   "metadata": {},
   "outputs": [],
   "source": [
    "def augment_data(X, y, n_augments_per_sample=6, noise_std=0.05, slice_ratio=0.9):\n",
    "    augmented_X = []\n",
    "    augmented_y = []\n",
    "\n",
    "    for x_i, y_i in zip(X, y):\n",
    "        for _ in range(n_augments_per_sample):\n",
    "            # Jittering\n",
    "            jittered = x_i + np.random.normal(0, noise_std, size=x_i.shape)\n",
    "\n",
    "            # Window slicing (keep a portion of the time series)\n",
    "            slice_len = int(slice_ratio * len(jittered))\n",
    "            start_idx = np.random.randint(0, len(jittered) - slice_len)\n",
    "            sliced = jittered[start_idx:start_idx + slice_len]\n",
    "\n",
    "            # Pad back to original length\n",
    "            if len(sliced) < len(x_i):\n",
    "                padded = np.pad(sliced, (0, len(x_i) - len(sliced)), mode='constant')\n",
    "            else:\n",
    "                padded = sliced\n",
    "\n",
    "            augmented_X.append(padded)\n",
    "            augmented_y.append(y_i)\n",
    "\n",
    "    return np.array(augmented_X), np.array(augmented_y)"
   ]
  },
